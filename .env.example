# Example values only. Replace both password placeholders before deployment.
# Do not commit your real .env file. URL-encode special characters in DATABASE_URL.
POSTGRES_DB=zetas
POSTGRES_USER=zetas
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://zetas:replace-with-a-strong-password@database:5432/zetas
APP_PORT=8080
LOG_LEVEL=info
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=https://your-domain.example