# Example only; NEVER use placeholders in production.
# Copy to .env (chmod 600), or inject through your host's secret manager.
# Use a random hexadecimal database password to avoid URL/interpolation issues.
POSTGRES_DB=zetas
POSTGRES_USER=zetas
POSTGRES_PASSWORD=
# Same database/user/password as above; URL-encode non-hex password characters.
DATABASE_URL=
# Example format: postgresql://zetas:PASSWORD@database:5432/zetas
APP_BIND=127.0.0.1
APP_PORT=8080
LOG_LEVEL=info
SESSION_SECRET=
# Public HTTPS origin only, without a path or trailing slash.
APP_ORIGIN=https://your-domain.example
# Trusted Nginx source IPs/CIDRs, never true, a hop count, or 0.0.0.0/0.
# Compose's private, unexposed API defaults to loopback,uniquelocal (RFC1918/ULA).
# Outside Compose the default is loopback only. Prefer the exact Nginx IP/CIDR
# if known, e.g. TRUST_PROXY=loopback,172.20.0.2/32 (example address only).
# Keep API ports private and let the TLS proxy overwrite forwarding headers.
# Cloudflare must use Full (strict) HTTPS to the TLS proxy, not Flexible HTTP.
# Optional Lazada phase 7; use an app whose status is Testing in Lazada App Console.
# Real credential values belong ONLY in your private secret manager/environment.
LAZADA_MODE=testing
LAZADA_COUNTRY=id
# Optional webhook site; empty defaults to lazada_<LAZADA_COUNTRY>.
# Set the exact site independently, only after confirming it for your app.
LAZADA_SITE=
LAZADA_REDIRECT_URI=https://your-domain.example/api/lazada/oauth/callback
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
# Independent random 32-byte key encoded as 64 hexadecimal characters.
LAZADA_TOKEN_ENCRYPTION_KEY=