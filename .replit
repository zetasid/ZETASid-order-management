modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["docker-compose", "nginx", "actionlint", "postgresql_17"]

[userenv]

[userenv.shared]
AUTH_SETUP_EMAIL = "admin@zetas.id"
LAZADA_MODE = "testing"
LAZADA_REDIRECT_URI = "https://46f324f1-fb9e-4d25-8139-6c1debf0bce3-00-n3izhimkt3ox.archer.replit.dev/api/lazada/oauth/callback"
